# ---------------------------------------------------------------------------
# CQA configuration. Copy to `.env` (git-ignored) and fill in. Real env vars win.
# ---------------------------------------------------------------------------

# --- Provider -------------------------------------------------------------
# anthropic : Claude via tool use (recommended, used for reported results)
# openai    : any OpenAI-compatible endpoint (Ollama / vLLM / LM Studio) — local LLM mode
# mock      : offline deterministic heuristic, no key needed (tests, CI, demo)
CQA_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Single-model mode (used when CQA_ENSEMBLE=0, or for provider=openai)
CQA_MODEL=claude-sonnet-5-5

# --- Jury mode (anthropic only) ---------------------------------------------
# Jurors score every criterion in parallel; on disagreement the judge decides.
CQA_ENSEMBLE=1
CQA_JURORS=claude-haiku-5-5,claude-sonnet-5-5
CQA_JUDGE=claude-opus-5-5

# --- Local LLM (provider=openai) --------------------------------------------
# CQA_PROVIDER=openai
# CQA_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# CQA_OPENAI_API_KEY=ollama
# CQA_MODEL=qwen2.5:14b

# --- Data source -------------------------------------------------------------
# Organizer endpoint; `&group_id=<ID>` is appended automatically. NEVER commit the real URL.
CQA_API_URL=<signed-invoke-url-from-organizers>

# --- Tuning ------------------------------------------------------------------
# Parallel (dialog x criterion) tasks
CQA_CONCURRENCY=24
# Checklist auto-selection by channel
# CQA_CHECKLIST_CHAT=freedom_chat_v1
# CQA_CHECKLIST_CALL=freedom_call_v1
