{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "cqa-results-1.0",
 "title": "CQA results.json, format JSON 1.0 (organizer Student Guide appendix)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "team_name",
  "model",
  "results"
 ],
 "properties": {
  "schema_version": {
   "const": "1.0"
  },
  "team_name": {
   "type": "string",
   "minLength": 1
  },
  "model": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "mode",
    "name"
   ],
   "properties": {
    "mode": {
     "enum": [
      "local",
      "external_api",
      "hybrid"
     ]
    },
    "name": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "results": {
   "type": "array",
   "items": {
    "oneOf": [
     {
      "$ref": "#/$defs/ok"
     },
     {
      "$ref": "#/$defs/error"
     }
    ]
   }
  }
 },
 "$defs": {
  "criterion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "criterion_id",
    "value",
    "rationale",
    "evidence_turns"
   ],
   "properties": {
    "criterion_id": {
     "type": "string",
     "minLength": 1
    },
    "value": {
     "type": [
      "boolean",
      "integer",
      "null"
     ]
    },
    "rationale": {
     "type": "string"
    },
    "evidence_turns": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  },
  "ok": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "conversation_id",
    "status",
    "criteria",
    "score"
   ],
   "properties": {
    "conversation_id": {
     "type": "string",
     "minLength": 1
    },
    "status": {
     "const": "ok"
    },
    "criteria": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/criterion"
     },
     "minItems": 1
    },
    "score": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "final_score",
      "critical_flag"
     ],
     "properties": {
      "final_score": {
       "type": "number",
       "minimum": 0,
       "maximum": 100
      },
      "critical_flag": {
       "type": "boolean"
      }
     }
    }
   }
  },
  "error": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "conversation_id",
    "status",
    "criteria",
    "score",
    "error"
   ],
   "properties": {
    "conversation_id": {
     "type": "string",
     "minLength": 1
    },
    "status": {
     "const": "error"
    },
    "criteria": {
     "type": "array",
     "maxItems": 0
    },
    "score": {
     "type": "null"
    },
    "error": {
     "type": "string",
     "minLength": 1
    }
   }
  }
 }
}
